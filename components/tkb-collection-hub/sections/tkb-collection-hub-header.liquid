{{ 'tkb-collection-hub.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.custom_image
  if hero_image == blank and section.settings.use_collection_image
    assign hero_image = collection.image
  endif

  assign hero_description = section.settings.custom_description
  if hero_description == blank and section.settings.show_collection_description
    assign hero_description = collection.description
  endif

  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_color = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
-%}

<section
  class="tkb-collection-hub tkb-collection-hub--{{ section.settings.alignment }}"
  style="
    --tkb-hub-hero-height: {{ section.settings.height }}px;
    --tkb-hub-hero-height-mobile: {{ section.settings.mobile_height }}px;
    --tkb-hub-max-width: {{ section.settings.max_width }}px;
    --tkb-hub-copy-width: {{ section.settings.copy_width }}px;
    --tkb-hub-fallback-bg: {{ section.settings.background_color }};
    --tkb-hub-text: {{ section.settings.text_color }};
    --tkb-hub-overlay: {{ overlay_color }};
  "
>
  {%- if hero_image != blank -%}
    <div class="tkb-collection-hub__media" aria-hidden="true">
      {{ hero_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}

  <div class="tkb-collection-hub__overlay" aria-hidden="true"></div>

  <div class="tkb-collection-hub__inner">
    <div class="tkb-collection-hub__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tkb-collection-hub__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.show_title -%}
        <h1 class="tkb-collection-hub__title">{{ collection.title }}</h1>
      {%- endif -%}

      {%- if hero_description != blank -%}
        <div class="tkb-collection-hub__description rte">{{ hero_description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TKB collection hub header",
  "tag": "section",
  "class": "section-tkb-collection-hub-header",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "show_title", "label": "Show collection title", "default": true },
    { "type": "checkbox", "id": "show_collection_description", "label": "Use collection description", "default": true },
    { "type": "richtext", "id": "custom_description", "label": "Custom description", "info": "If filled in, this replaces the collection description in the hero." },

    { "type": "header", "content": "Image" },
    { "type": "checkbox", "id": "use_collection_image", "label": "Use collection image", "default": true },
    { "type": "image_picker", "id": "custom_image", "label": "Custom hero image", "info": "Overrides the collection image when selected." },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#17222a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "range", "id": "height", "label": "Desktop hero height", "min": 280, "max": 720, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "mobile_height", "label": "Mobile hero height", "min": 240, "max": 560, "step": 20, "unit": "px", "default": 340 },
    { "type": "range", "id": "max_width", "label": "Maximum content width", "min": 960, "max": 1800, "step": 40, "unit": "px", "default": 1400 },
    { "type": "range", "id": "copy_width", "label": "Maximum text width", "min": 420, "max": 1000, "step": 20, "unit": "px", "default": 760 }
  ],
  "presets": [
    { "name": "TKB collection hub header" }
  ]
}
{% endschema %}
