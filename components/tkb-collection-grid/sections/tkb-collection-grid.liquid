{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'tkb-collection-grid.css' | asset_url | stylesheet_tag }}

<section
  class="tkb-collection-grid"
  style="
    --tkb-collection-max-width: {{ section.settings.max_width }}px;
    --tkb-collection-gap: {{ section.settings.card_gap }}px;
    --tkb-collection-columns-desktop: {{ section.settings.columns_desktop }};
    --tkb-collection-columns-tablet: {{ section.settings.columns_tablet }};
    --tkb-collection-columns-mobile: {{ section.settings.columns_mobile }};
    --tkb-collection-padding-top: {{ section.settings.padding_top }}px;
    --tkb-collection-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="tkb-collection-grid__inner">
    {%- if section.settings.show_header -%}
      <header class="tkb-collection-grid__header tkb-collection-grid__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tkb-collection-grid__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h1 class="tkb-collection-grid__title">{{ collection.title }}</h1>

        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="tkb-collection-grid__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {% paginate collection.products by 12 %}
      {%- if collection.products_count > 0 -%}
        <div class="tkb-collection-grid__products">
          {%- for product in collection.products -%}
            {% render 'product-card',
              product: product,
              show_vendor: section.settings.show_vendor,
              show_product_type: section.settings.show_product_type,
              show_price: true,
              show_compare_price: section.settings.show_compare_price,
              show_swatches: section.settings.show_swatches,
              max_swatches: section.settings.max_swatches,
              show_quick_note: section.settings.show_quick_note,
              show_left_badge: section.settings.show_left_badge,
              show_right_badge: section.settings.show_right_badge
            %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="tkb-collection-grid__pagination" role="navigation" aria-label="Collection pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span{% if part.title == paginate.current_page %} class="current" aria-current="page"{% endif %}>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page">›</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="tkb-collection-grid__empty">No products are currently available in this collection.</div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "TKB collection product grid",
  "tag": "section",
  "class": "section-tkb-collection-grid",
  "settings": [
    { "type": "header", "content": "Collection header" },
    { "type": "checkbox", "id": "show_header", "label": "Show collection header", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "Product cards" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_product_type", "label": "Show product type", "default": false },
    { "type": "checkbox", "id": "show_compare_price", "label": "Show compare-at price", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true },
    { "type": "range", "id": "max_swatches", "label": "Maximum swatches", "min": 1, "max": 8, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_quick_note", "label": "Show quick note", "default": true },
    { "type": "checkbox", "id": "show_left_badge", "label": "Show left badge", "default": true },
    { "type": "checkbox", "id": "show_right_badge", "label": "Show right badge", "default": true },

    { "type": "header", "content": "Grid layout" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_tablet", "label": "Tablet columns", "default": "3", "options": [
      { "value": "2", "label": "2" },
      { "value": "3", "label": "3" }
    ] },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "default": "2", "options": [
      { "value": "1", "label": "1" },
      { "value": "2", "label": "2" }
    ] },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "max_width", "label": "Maximum content width", "min": 960, "max": 1800, "step": 40, "unit": "px", "default": 1400 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    { "name": "TKB collection product grid" }
  ]
}
{% endschema %}
